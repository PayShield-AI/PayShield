# PayShield - Environment Configuration

# Server Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
DEBUG=true

# PayPal Developer Sandbox Credentials
# Get your Sandbox API keys at: https://developer.paypal.com/dashboard/applications/sandbox
# If left as default, PayShield activates simulated sandbox mode for frictionless demoing!
PAYPAL_CLIENT_ID=sb
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Optional: Google Gemini API Key for deep LLM reasoning
# If omitted, PayShield uses its built-in NLP & heuristic AI scam engine offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
